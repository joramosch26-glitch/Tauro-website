{
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/paint-guide",
      "destination": "/paint-guide.html"
    },
    {
      "source": "/paint-guide/:path*",
      "destination": "/paint-guide.html"
    }
  ]
}
